# Generated by Avokaido, and run by .github/workflows/release-*.yml.
#
#   bundle exec fastlane ios testflight   — sign with match, upload to TestFlight
#   bundle exec fastlane android internal — upload the bundle to Play internal testing
#
# Every credential comes from the environment the workflow sets from this
# repository's Actions secrets. Nothing secret is written to a file.

APP_ID = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
APP_NAME = "Avokaido Starter"

platform :ios do
  desc "Sign a release build with match and upload it to TestFlight"
  lane :testflight do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: false
    )

    # Best effort: the bundle identifier has to exist in the developer portal
    # before match can make a profile for it, and an App Store Connect key may
    # register one. Creating the App Store Connect app record is NOT possible
    # with a key — Apple requires a person — so the first upload of a new app
    # needs that record made by hand once.
    begin
      unless Spaceship::ConnectAPI::BundleId.find(APP_ID)
        Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, identifier: APP_ID, platform: "IOS")
        UI.success("Registered #{APP_ID} in the developer portal")
      end
    rescue => e
      UI.important("Could not register #{APP_ID} (#{e.message}); continuing")
    end

    match(api_key: api_key, readonly: false)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Runner.xcodeproj",
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: ENV["sigh_#{APP_ID}_appstore_profile-name"],
      team_id: ENV["sigh_#{APP_ID}_appstore_team-id"]
    )

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build/ios/ipa"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end

platform :android do
  desc "Upload the release bundle to Google Play's internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("PLAY_DEVELOPER_SERVICE_ACCOUNT"),
      package_name: APP_ID,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
